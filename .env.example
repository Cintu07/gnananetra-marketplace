# Local development: copy to .env.local. On Cloudflare, plain values go in wrangler.jsonc "vars"
# and secrets via `npx wrangler secret put NAME` (see docs/DEPLOY-CLOUDFLARE.md).

# The database is Cloudflare D1 (binding DB in wrangler.jsonc). Locally `npm run db` creates it
# under .wrangler/; nothing to set here.
# 32+ random characters, signs login cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# public address, used in emails, sitemap and invoices
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# first admin account, created or reset by `npm run import:wp`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay (Account & Settings > API keys). Empty = test payments (development only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook: https://<domain>/api/webhooks/razorpay, events payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=
# lets a production build accept test payments (local previews only, never on the live site)
# ALLOW_TEST_PAYMENTS=true

# Resend (resend.com) for order and password emails. Empty = printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=Gnananetra <orders@gnananetra.com>

# Photo uploads go to the R2 bucket bound as MEDIA (wrangler.jsonc); locally a local copy of it.
