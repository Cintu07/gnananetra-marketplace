{
  "name": "gnananetra-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gnananetra Marketplace: sellers onboard and sell through one storefront. Built on the Gnananetra shop.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db": "wrangler d1 migrations apply gnananetra-marketplace --local",
    "db:reset": "node scripts/db-reset.mjs && npm run db",
    "db:generate": "drizzle-kit generate",
    "images": "node scripts/build-logo.mjs && node scripts/build-images.mjs",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "race": "tsx --env-file-if-exists=.env.local scripts/race.ts",
    "audit:mobile": "node --env-file-if-exists=.env.local scripts/mobile-audit.mjs",
    "check": "npm run typecheck && npm run build",
    "db:push:remote": "tsx scripts/push-remote.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply gnananetra-marketplace --remote",
    "import": "tsx --env-file-if-exists=.env.local scripts/import-catalog.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "drizzle-kit": "^0.31.11",
    "potrace": "^2.1.8",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
